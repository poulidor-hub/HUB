# Secrets - JAMAIS dans Git
secrets/jwt_private_key.pem
secrets/*.key
secrets/sa_*.env
secrets/service_accounts/*.env
secrets/backup_private_key.pem
secrets/backup_public_key.pem
.env.prod
*.pem
# Exports/backups sensibles (hashes, topologie) - toutes profondeurs
secrets/**/*.json
secrets/service_accounts/hub_backup.json
# Secrets service accounts a toute profondeur (defense en profondeur)
secrets/**/sa_*.env
secrets/**/service_accounts/*.env
# Dossiers secrets imbriques (anti-regression bug restore snapshot)
secrets/secrets/

