# Secrets - JAMAIS dans Git
secrets/jwt_private_key.pem
secrets/*.key
secrets/sa_*.env
secrets/service_accounts/*.env
secrets/backup_private_key.pem
secrets/backup_public_key.pem
.env.prod
*.pem
# Exports/backups sensibles (hashes, topologie) - toutes profondeurs
secrets/**/*.json
secrets/service_accounts/hub_backup.json
# Secrets service accounts a toute profondeur (defense en profondeur)
secrets/**/sa_*.env
secrets/**/service_accounts/*.env
# Dossiers secrets imbriques (anti-regression bug restore snapshot)
secrets/secrets/

# PKI / Certificats - Clés privées et certificats générés
certs/
certs/ca/*.key
certs/ca/*.crt
certs/server/**/*.key
certs/server/**/*.crt
certs/registry.json

# Superpowers (brainstorm visual companion artifacts)
.superpowers/

# Superpowers — plans d'implémentation auto-générés (éphémères)
docs/superpowers/plans/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Docker
.docker/

# Logs
*.log
logs/

#environement files
.env
.env.*
!.env.example

# Database
*.db
*.sqlite3

# OS
.DS_Store
Thumbs.db

# BACKUPS
*.zip

# Storage runtime (backups + snapshots générés par le hub — données, pas du code)
storage/backups/*
!storage/backups/README.md
storage/snapshots/

# Worktrees d'isolation agents (agent-isolation-git)
.worktrees/

# Identité runtime du Hub (unique par installation — jamais committée)
secrets/hub_instance_id

# Artefacts de couverture pytest (make test-cov)
.coverage
htmlcov/

# Chantier B — contenus générés du routage (les dossiers sont trackés via .gitkeep)
gateway/*
!gateway/.gitkeep
dns-generated/*
!dns-generated/.gitkeep

# Fichiers internes conservés localement, jamais publiés
/docs/superpowers/
/project.md
/SUIVI-audit-login-errors.md
/SECURITY_AUDIT.md
/vaultRestorHUB.md
/exemple-app.md
/TODO.md
