# Configuration Hub d'Authentification
# =====================================
# Copiez ce fichier en .env et adaptez les valeurs à votre environnement :
#   cp .env.example .env

# PostgreSQL
POSTGRES_USER=hubadmin
POSTGRES_PASSWORD=CHANGEZ_MOI_mot_de_passe_securise
POSTGRES_DB=hub_auth

# Hub API
DATABASE_URL=postgresql+asyncpg://hubadmin:CHANGEZ_MOI_mot_de_passe_securise@db:5432/hub_auth
JWT_ALGORITHM=RS256
# Environnement : production (strict, refuse les misconfigs) ou development (permissif)
APP_ENV=production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Admin par défaut (à changer après premier démarrage)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGEZ_MOI_admin_password
ADMIN_EMAIL=admin@local.lan

# Ports
HUB_API_PORT=8000

# Host du Hub (IP ou hostname accessible par les clients)
# Laisser vide pour détection automatique de l'IP
# Exemples: 192.168.1.100, monserveur.local, hub.mondomaine.fr
HUB_HOST=
HUB_FRONTEND_PORT=80

# Nom du projet Docker Compose. OBLIGATOIRE en coexistence (2 hubs sur le même
# host) pour isoler conteneurs/volumes/réseaux — sinon collision avec le projet
# implicite nommé d'après le dossier. Laisser vide pour un déploiement normal.
COMPOSE_PROJECT_NAME=

# UID/GID hôte utilisés pour les volumes et la lecture contrôlée de server.key par nginx.
HOST_UID=1000
HOST_GID=1000
# GID du groupe docker sur l'hôte (pour le mount du socket docker sur hub-api).
# Détecter avec : getent group docker | cut -d: -f3
HOST_DOCKER_GID=128

# Génération automatique des clés JWT si absentes (DEV uniquement)
# ⚠️ Mettre à false en production — les clés doivent être pré-générées et stables
AUTO_GENERATE_KEYS=false

# Chevauchement (en heures) entre l'ancienne et la nouvelle clé JWT lors d'une
# rotation (hubctl jwt rotate / UI admin) : les tokens signés avec l'ancienne
# clé restent acceptés pendant cette durée, le temps que les apps rafraîchissent
# leur JWKS. Lu au démarrage de l'API — redémarrer hub-api après modification.
JWT_KEY_OVERLAP_HOURS=24

# Auto-remplacement des applications existantes lors de l'enregistrement
# Si true : l'ancienne app et son M2M sont supprimés automatiquement
# Si false : conserve l'app existante avec ses credentials (recommandé)
FORCE_REPLACE_APP=false

# Clé de chiffrement des secrets des service accounts (Fernet)
# Générée avec: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ⚠️ Ne pas perdre cette clé : les secrets chiffrés ne seront plus déchiffrables sans elle
SECRETS_ENCRYPTION_KEY=

# Autorise les secrets en clair quand SECRETS_ENCRYPTION_KEY est vide (DEV uniquement).
# En production, laissez false et définissez une vraie clé Fernet.
ALLOW_PLAINTEXT_SECRETS=false

# Désactive le warning des mots de passe faibles. Utile pour les déploiements
# existants qui n'ont pas encore migré leurs secrets. Passez à false après rotation.
SKIP_PASSWORD_CHECK=false

# Synchronisation automatique avec Docker (en secondes)
# Scanne les conteneurs Docker et désactive les apps dont le conteneur est arrêté
# 0 = désactivé, 300 = toutes les 5 minutes (recommandé)
DOCKER_SYNC_INTERVAL=300

# Scan Docker (socket requis). false en production (aucun socket monté).
DOCKER_SCAN_ENABLED=false

# VPN WireGuard Server (config via UI admin, pas de variable .env requise)

# Cooldown pour les notifications SSE d'audit (en secondes)
# Évite les rafraîchissements trop fréquents de la page audit
# 5 = une notification toutes les 5 secondes max
AUDIT_SSE_COOLDOWN=5.0

# Rétention des logs d'audit (en jours)
# Les logs plus anciens seront automatiquement supprimés
# 0 = pas de purge automatique (conserver indéfiniment)
AUDIT_RETENTION_DAYS=90

# Rétention des logs d'erreurs HTTP (en jours)
# Les erreurs plus anciennes seront automatiquement supprimées
# 0 = pas de purge automatique
ERROR_RETENTION_DAYS=30

# Intervalle de purge des logs (en heures)
# Fréquence à laquelle le système vérifie et supprime les anciens logs
LOG_PURGE_INTERVAL_HOURS=24

# CORS — origines autorisées (frontends accessibles depuis le navigateur).
# Format : origines séparées par des virgules. Une par frontend (Hub + chaque app).
# ⚠️ Obligatoire en production (APP_ENV=production) : un Hub sans ALLOWED_ORIGINS refuse de démarrer.
# Pour ajouter une nouvelle app : ajoutez son origine frontend ici (ex: https://192.0.2.10:4243).
ALLOWED_ORIGINS=https://hub.local,https://192.0.2.10

# Optionnel : regex d'origines CORS (en plus de ALLOWED_ORIGINS).
# Ouvre tout un sous-réseau LAN sans lister chaque IP/port.
# Ex (LAN 192.168.1.0/24 + localhost) :
# ALLOWED_ORIGIN_REGEX=^https?://(192\.168\.1\.\d{1,3}|localhost|127\.0\.0\.1)(:\d+)?$
ALLOWED_ORIGIN_REGEX=

# Limite de taille du body côté API (protection DoS), en MB.
# - MAX_BODY_SIZE_MB : toutes les routes (défaut 10).
# - MAX_UPLOAD_BODY_SIZE_MB : routes d'upload de sauvegarde/import uniquement
#   (/api/admin/restore, /api/apps/{slug}/backup/import,
#   /api/apps/{slug}/backup/restore/upload). Doit rester <= client_max_body_size
#   de frontend/nginx*.conf (1G).
MAX_BODY_SIZE_MB=10
MAX_UPLOAD_BODY_SIZE_MB=512

# Whitelist des réseaux autorisés pour l'auto-enregistrement des applications.
# Format : CIDR (ou préfixes simples) séparés par des virgules.
# 1) Sous-réseau Docker fixe du Hub (= ipam.subnet de hub-network dans docker-compose.yml)
# 2) CIDR du LAN / VPN depuis lequel les apps et admins appellent le Hub
# Exemples de CIDR VPN à ajouter :
#   - Tailscale : 100.64.0.0/10
#   - WireGuard : votre /24 dédié, ex. 10.8.0.0/24
# ⚠️ SÉCURITÉ : n'ajoutez QUE des réseaux de confiance. Ne remettez jamais 172.16.0.0/12.
APP_WHITELIST_NETWORKS=10.42.0.0/16,192.168.1.0/24

# =============================================================================
# PKI - Gestion des Certificats SSL/TLS
# =============================================================================
# HTTPS est activé automatiquement si les certificats existent dans certs/server/hub/
# Commandes : python pki.py init && python pki.py cert create hub

# Activer le HTTPS du Hub (terminaison TLS sur le frontend). true par défaut.
# Mettre false pour un fonctionnement strictement HTTP (comme avant).
HUB_HTTPS_ENABLED=true

# Port HTTPS (443 par défaut)
HUB_HTTPS_PORT=443

# -----------------------------------------------------------------------------
# Autorité de Certification (CA) - Informations d'identité
# -----------------------------------------------------------------------------
# Ces valeurs apparaissent dans le certificat racine (purement informatif)
PKI_CA_COMMON_NAME=Hub Local CA
PKI_CA_ORGANIZATION=Hub Internal
PKI_CA_VALIDITY_YEARS=10

# -----------------------------------------------------------------------------
# Certificats Serveur - Configuration technique
# -----------------------------------------------------------------------------
# Domaines DNS inclus dans les certificats (le navigateur vérifie la correspondance)
# ⚠️ Ajoutez ici tous les noms d'hôte utilisés pour accéder au Hub
PKI_CERT_DOMAINS=localhost,hub.local,hub-frontend

# IPs supplémentaires (l'IP du serveur est auto-détectée via HUB_HOST)
PKI_CERT_IPS=

# Validité des certificats serveur (recommandé : 365 jours pour rotation annuelle)
PKI_CERT_VALIDITY_DAYS=365

# Taille des clés RSA : 2048 (standard) ou 4096 (haute sécurité)
PKI_KEY_SIZE=4096

# -----------------------------------------------------------------------------
# Proxy transparent PhiliaNG (service.example.org)
# -----------------------------------------------------------------------------
# Le hub-frontend proxifie service.example.org vers le proxy Philia (port 4443).
# Nécessite un certificat SNI dédié (certs/server/philia-ng/), AUTO-GÉNÉRÉ par
# le hub-api au démarrage s'il est absent → le vhost est actif par défaut sur
# tout déploiement, sans manip manuelle.
# Le domaine doit matcher le server_name de frontend/nginx-philia-ng.conf.
PHILIA_NG_DOMAIN=service.example.org
HOST_UID=1000

# Compatibilité legacy (désactivée par défaut, activer uniquement si des apps
# utilisent l'ancien système d'appel inter-apps sans M2M)
LEGACY_COMPAT_ENABLED=false

# === Pool d'allocation dynamique des ports d'applications ===
# Plages dans lesquelles le Hub attribue les ports des apps (endpoint allocate-ports).
# Le frontend est alloué par pas de 2 (le port+1 est réservé pour le HTTPS).
APP_PORT_API_START=9000
APP_PORT_API_END=9499
APP_PORT_FRONTEND_START=4200
APP_PORT_FRONTEND_END=4699
# Exclure de l'attribution les ports déjà liés sur l'hôte local par Docker
# (scan best-effort via le socket Docker, au moment de l'allocation).
PORT_SCAN_DOCKER_ENABLED=true

# === Pool d'allocation des sous-réseaux Docker des apps ===
# Attribué par allocate-ports (champ `subnet`) : un /N par app, épinglé dans
# le docker-compose de l'app (APP_SUBNET). Doit rester disjoint du LAN
# (192.168.1.0/24), du VPN routeur (198.51.100.60/24) et des réseaux existants.
# 10.50.0.0/16 ÷ /24 = 256 apps. Élargir si besoin (ex: 10.48.0.0/14 = 1024).
APP_SUBNET_POOL=10.50.0.0/16
APP_SUBNET_SIZE=24

# Durée (minutes) d'une réservation de ports : allocation sans application
# associée (prepare du catalogue GitHub, /allocate-ports orphelin). Passé ce
# délai, ports et sous-réseau redeviennent attribuables. 0 = jamais.
PORT_RESERVATION_TTL_MINUTES=30

# === Déploiement automatique des apps ===
# Chemin absolu du dossier APPS/ (identique hôte/conteneur — déploiement auto).
# À ADAPTER : chemin réel de APPS/ sur CE serveur (install.sh l'écrit
# automatiquement avec la valeur détectée). docker-compose refuse de démarrer
# sans cette variable.
APPS_HOST_PATH=/chemin/absolu/vers/POULIDOR/APPS

# ============================================================
# OIDC Provider (bridge OIDC pour apps externes type Vikunja)
# ============================================================
OIDC_ENABLED=true
OIDC_ISSUER=https://hub.example.com
OIDC_EMAIL_TEMPLATE={username}@hub.internal
OIDC_CODE_TTL_SECONDS=30
OIDC_ID_TOKEN_TTL_MINUTES=10
OIDC_ACCESS_TOKEN_TTL_MINUTES=15
OIDC_REFRESH_TOKEN_DAYS=30
OIDC_BACKCHANNEL_LOGOUT_ENABLED=true
# SLO poste partagé (v3.26.0) — Déconnexion propagée entre apps quand un utilisateur
# se déconnecte d'une app OIDC. False par défaut, activer en production après tests.
OIDC_SLO_ENABLED=false
OIDC_SLO_IFRAME_TIMEOUT_MS=1500

# Service Account interne du HUB (utilisé pour les appels M2M entre le HUB et lui-même).
# Générés automatiquement par install.sh --auto. Si vous créez .env manuellement,
# générez HUB_INTERNAL_SA_CLIENT_SECRET avec : openssl rand -base64 32
HUB_INTERNAL_SA_CLIENT_ID=hub-internal
HUB_INTERNAL_SA_CLIENT_SECRET=
